{
  "uid": "gains",
  "title": "gains",
  "description": "Workout log from the gains app. Three panels, one per measurement kind, so every series in a panel shares a y axis. Each bar is the SUM over its bucket, never an average; bucket width follows the zoom, so a week-wide view gives that week's total.",
  "tags": [
    "gains",
    "training"
  ],
  "timezone": "America/Los_Angeles",
  "editable": true,
  "schemaVersion": 39,
  "version": 0,
  "refresh": "5m",
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Volume",
      "description": "Sum of weight x reps per exercise, per bucket. Bucket width follows the zoom via $__interval, so a week-wide view shows that week's total rather than an average of it.",
      "datasource": {
        "type": "prometheus",
        "uid": "dft9acuz7p05cd"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "maxDataPoints": 100,
      "interval": "1h",
      "targets": [
        {
          "refId": "A",
          "expr": "sum_over_time({__name__=~\"health_.+_volume\"}[$__interval]) keep_metric_names",
          "legendFormat": "{{__name__}}"
        }
      ],
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "health_(.+)_volume",
            "renamePattern": "$1"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix:kg",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 75,
            "spanNulls": false,
            "axisLabel": "kg",
            "gradientMode": "none",
            "barAlignment": 0,
            "barWidthFactor": 0.9,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Reps",
      "description": "Sum of reps per exercise, per bucket. Loaded lifts appear here as well as bodyweight work \u2014 a rep is a rep, so the y axis still holds.",
      "datasource": {
        "type": "prometheus",
        "uid": "dft9acuz7p05cd"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "maxDataPoints": 100,
      "interval": "1h",
      "targets": [
        {
          "refId": "A",
          "expr": "sum_over_time({__name__=~\"health_.+_reps\"}[$__interval]) keep_metric_names",
          "legendFormat": "{{__name__}}"
        }
      ],
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "health_(.+)_reps",
            "renamePattern": "$1"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 75,
            "spanNulls": false,
            "axisLabel": "reps",
            "gradientMode": "none",
            "barAlignment": 0,
            "barWidthFactor": 0.9,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "timeseries",
      "title": "Time",
      "description": "Sum of seconds per exercise, per bucket. Planks, dead hangs, wall sits \u2014 and any cardio with a logged time.",
      "datasource": {
        "type": "prometheus",
        "uid": "dft9acuz7p05cd"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "maxDataPoints": 100,
      "interval": "1h",
      "targets": [
        {
          "refId": "A",
          "expr": "sum_over_time({__name__=~\"health_.+_seconds\"}[$__interval]) keep_metric_names",
          "legendFormat": "{{__name__}}"
        }
      ],
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "health_(.+)_seconds",
            "renamePattern": "$1"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 75,
            "spanNulls": false,
            "axisLabel": "seconds",
            "gradientMode": "none",
            "barAlignment": 0,
            "barWidthFactor": 0.9,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
}
