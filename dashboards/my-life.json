{
  "uid": "my-life",
  "title": "My Life",
  "description": "Personal metrics from HealthKit via iOS Shortcuts, stored in VictoriaMetrics on the Linode. Top row is pinned to the current Mon-Su week; everything below follows the time picker.",
  "tags": ["life", "health"],
  "timezone": "browser",
  "weekStart": "monday",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5m",
  "schemaVersion": 39,
  "version": 3,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "This week",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 1,
      "type": "barchart",
      "title": "Steps",
      "description": "Pinned to now/w -> now (Monday 00:00 through now) via the panel's Relative time override, so the picker below doesn't move it. Days later in the week aren't drawn yet — Grafana has no per-panel 'time to' override, only 'time from'. The x axis is the time field rendered as time:ddd, i.e. the weekday name.",
      "datasource": { "type": "prometheus", "uid": "dft9acuz7p05cd" },
      "gridPos": { "h": 9, "w": 16, "x": 0, "y": 1 },
      "timeFrom": "now/w",
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "dft9acuz7p05cd" },
          "editorMode": "code",
          "expr": "last_over_time(health_step[1d])",
          "interval": "1d",
          "legendFormat": "steps",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 85,
            "gradientMode": "none",
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "axisBorderShow": false,
            "scaleDistribution": { "type": "linear" },
            "thresholdsStyle": { "mode": "off" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byType", "options": "time" },
            "properties": [{ "id": "unit", "value": "time:ddd" }]
          }
        ]
      },
      "options": {
        "orientation": "vertical",
        "barRadius": 0.15,
        "barWidth": 0.6,
        "groupWidth": 0.7,
        "showValue": "always",
        "stacking": "none",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "fullHighlight": false,
        "legend": { "showLegend": false, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Steps to goal",
      "description": "70000 minus the sum of this week's samples. $__range resolves to this panel's own overridden range (now/w -> now), so it is Monday-to-now regardless of the picker. clamp_min holds it at 0 once the goal is met. Deliberately uncoloured: 60K remaining on a Monday is on track, so threshold colours would read as a false alarm all week.",
      "datasource": { "type": "prometheus", "uid": "dft9acuz7p05cd" },
      "gridPos": { "h": 9, "w": 8, "x": 16, "y": 1 },
      "timeFrom": "now/w",
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "dft9acuz7p05cd" },
          "editorMode": "code",
          "expr": "clamp_min(70000 - sum_over_time(health_step[$__range]), 0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "text" },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Goal met", "index": 0 }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "text", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      }
    },
    {
      "id": 200,
      "type": "row",
      "title": "History",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 10 },
      "panels": []
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Daily steps",
      "description": "last_over_time reads raw samples only, so a day you didn't sync shows a gap instead of silently inheriting the previous day's count (which is what the 720h staleness window would otherwise do). spanNulls is off here on purpose — unlike weight, a missing step count is real information.",
      "datasource": { "type": "prometheus", "uid": "dft9acuz7p05cd" },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 11 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "dft9acuz7p05cd" },
          "editorMode": "code",
          "expr": "last_over_time(health_step[1d])",
          "interval": "1d",
          "legendFormat": "steps",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "blue" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "none",
            "showPoints": "auto",
            "pointSize": 8,
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "axisBorderShow": false,
            "scaleDistribution": { "type": "linear" },
            "thresholdsStyle": { "mode": "off" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "blue", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": false, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Weight (lbs)",
      "description": "spanNulls joins across missed days — weight is a slow-moving trend, so a gap is noise rather than signal.",
      "datasource": { "type": "prometheus", "uid": "dft9acuz7p05cd" },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 11 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "dft9acuz7p05cd" },
          "editorMode": "code",
          "expr": "last_over_time(health_weight[1d])",
          "interval": "1d",
          "legendFormat": "weight",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": { "mode": "fixed", "fixedColor": "purple" },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "none",
            "showPoints": "always",
            "pointSize": 8,
            "spanNulls": true,
            "axisPlacement": "auto",
            "axisBorderShow": false,
            "scaleDistribution": { "type": "linear" },
            "thresholdsStyle": { "mode": "off" }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [{ "color": "purple", "value": null }]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "showLegend": false, "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "single", "sort": "none" }
      }
    }
  ]
}
