{
  "uid": "proto",
  "title": "proto",
  "description": "Personal metrics from HealthKit via iOS Shortcuts, stored in VictoriaMetrics on the Linode. Top row is pinned to the current Mon-Su week; everything below follows the time picker.",
  "tags": [
    "life",
    "health"
  ],
  "timezone": "browser",
  "weekStart": "monday",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5m",
  "schemaVersion": 39,
  "version": 9,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "This week",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 1,
      "type": "barchart",
      "title": "Steps",
      "description": "Pinned to now/w -> now (Monday 00:00 through now) via the panel's Relative time override, so the picker below doesn't move it. Days later in the week aren't drawn yet \u2014 Grafana has no per-panel 'time to' override, only 'time from'. The x axis is the time field rendered as time:ddd, i.e. the weekday name.",
      "datasource": {
        "type": "prometheus",
        "uid": "dft9acuz7p05cd"
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 1
      },
      "timeFrom": "now/w",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dft9acuz7p05cd"
          },
          "editorMode": "code",
          "expr": "last_over_time(health_step[1d])",
          "interval": "1d",
          "legendFormat": "steps",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {
            "lineWidth": 0,
            "fillOpacity": 85,
            "gradientMode": "none",
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "axisBorderShow": false,
            "scaleDistribution": {
              "type": "linear"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byType",
              "options": "time"
            },
            "properties": [
              {
                "id": "unit",
                "value": "time:ddd"
              }
            ]
          }
        ]
      },
      "options": {
        "orientation": "vertical",
        "barRadius": 0.15,
        "barWidth": 0.6,
        "groupWidth": 0.7,
        "showValue": "always",
        "stacking": "none",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "fullHighlight": false,
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Steps to goal",
      "description": "70000 minus the sum of this week's samples. $__range resolves to this panel's own overridden range (now/w -> now), so it is Monday-to-now regardless of the picker. clamp_min holds it at 0 once the goal is met. Deliberately uncoloured: 60K remaining on a Monday is on track, so threshold colours would read as a false alarm all week.",
      "datasource": {
        "type": "prometheus",
        "uid": "dft9acuz7p05cd"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "timeFrom": "now/w",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dft9acuz7p05cd"
          },
          "editorMode": "code",
          "expr": "clamp_min(70000 - sum_over_time(health_step[$__range]), 0)",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "text"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Goal met",
                  "index": 0
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value",
        "wideLayout": true,
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      }
    },
    {
      "id": 200,
      "type": "row",
      "title": "History",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "panels": []
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Daily steps",
      "description": "last_over_time reads raw samples only, so a day you didn't sync shows a gap instead of silently inheriting the previous day's count (which is what the 720h staleness window would otherwise do). spanNulls is off here on purpose \u2014 unlike weight, a missing step count is real information.",
      "datasource": {
        "type": "prometheus",
        "uid": "dft9acuz7p05cd"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dft9acuz7p05cd"
          },
          "editorMode": "code",
          "expr": "last_over_time(health_step[1d])",
          "interval": "1d",
          "legendFormat": "steps",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "dft9acuz7p05cd"
          },
          "editorMode": "code",
          "expr": "range_linear_regression(last_over_time(health_step[1d]))",
          "interval": "1d",
          "legendFormat": "trend",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "none",
            "showPoints": "auto",
            "pointSize": 8,
            "spanNulls": false,
            "axisPlacement": "auto",
            "axisSoftMin": 0,
            "axisBorderShow": false,
            "scaleDistribution": {
              "type": "linear"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "semi-dark-red"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "custom.showPoints",
                "value": "never"
              },
              {
                "id": "custom.spanNulls",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Weight (lbs)",
      "description": "The `> 0` drops days where HealthKit had no sample and the Shortcut sent 0 \u2014 a zero would otherwise crater the axis. Nulls never reach storage; the shim skips them. spanNulls joins across the resulting gaps, since weight is a slow-moving trend where a gap is noise rather than signal.",
      "datasource": {
        "type": "prometheus",
        "uid": "dft9acuz7p05cd"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 11
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dft9acuz7p05cd"
          },
          "editorMode": "code",
          "expr": "last_over_time(health_weight[1d]) > 0",
          "interval": "1d",
          "legendFormat": "weight",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "dft9acuz7p05cd"
          },
          "editorMode": "code",
          "expr": "range_linear_regression(last_over_time(health_weight[1d]) > 0)",
          "interval": "1d",
          "legendFormat": "trend",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 0,
            "gradientMode": "none",
            "showPoints": "always",
            "pointSize": 5,
            "spanNulls": true,
            "axisPlacement": "auto",
            "axisBorderShow": false,
            "scaleDistribution": {
              "type": "linear"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "purple",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "semi-dark-red"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              },
              {
                "id": "custom.lineWidth",
                "value": 2
              },
              {
                "id": "custom.showPoints",
                "value": "never"
              },
              {
                "id": "custom.spanNulls",
                "value": true
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    },
    {
      "id": 7,
      "type": "volkovlabs-echarts-panel",
      "title": "Step calendar",
      "description": "GitHub-style contribution grid via Apache ECharts calendar + heatmap. The dedicated calendar-heatmap plugin can't do this: its source has no reference to thresholds or fieldConfig, and colorScheme is a single-hue ramp, so red-below-goal and green-above is impossible there. ECharts visualMap.pieces gives discrete threshold bands instead.",
      "datasource": {
        "type": "prometheus",
        "uid": "dft9acuz7p05cd"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "dft9acuz7p05cd"
          },
          "editorMode": "code",
          "expr": "last_over_time(health_step[1d])",
          "interval": "1d",
          "legendFormat": "steps",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "getOption": "// Business Charts v7 passes a single `context` argument:\n//   { grafana: {theme, ...}, panel: {data, chart}, echarts, ecStat }\nconst data = context.panel.data;\nconst theme = context.grafana.theme;\n\nconst frame = data.series && data.series[0];\nif (!frame) { return {}; }\n\nconst arr = (f) => (f && f.values && f.values.toArray) ? f.values.toArray() : (f ? f.values : []);\nconst tf = frame.fields.find((f) => f.type === 'time');\nconst vf = frame.fields.find((f) => f.type === 'number');\nconst ts = arr(tf), vs = arr(vf);\n\n// Bucket by LOCAL calendar day; last value wins within a day.\nconst byDay = new Map();\nfor (let i = 0; i < ts.length; i++) {\n  const v = vs[i];\n  if (v === null || v === undefined || Number.isNaN(v)) { continue; }\n  const d = new Date(ts[i]);\n  const key = d.getFullYear() + '-' +\n    String(d.getMonth() + 1).padStart(2, '0') + '-' +\n    String(d.getDate()).padStart(2, '0');\n  byDay.set(key, v);\n}\nconst points = Array.from(byDay, (e) => [e[0], e[1]]);\nif (!points.length) { return {}; }\n\nconst days = points.map((p) => p[0]).sort();\nconst range = [days[0], days[days.length - 1]];\n\nconst c = (theme && theme.colors) ? theme.colors : null;\nconst ink   = c ? c.text.primary   : '#ccc';\nconst ink2  = c ? c.text.secondary : '#888';\nconst empty = c ? c.background.secondary : '#22252b';\nconst gap   = c ? c.background.primary   : '#111217';\n\nreturn {\n  tooltip: {\n    formatter: (p) => p.value[0] + '<br/><b>' + Math.round(p.value[1]).toLocaleString() + '</b> steps'\n  },\n  visualMap: {\n    type: 'piecewise',\n    orient: 'horizontal',\n    left: 'center',\n    bottom: 0,\n    itemWidth: 12,\n    itemHeight: 12,\n    textStyle: { color: ink2 },\n    pieces: [\n      { lt: 5000,               color: '#C4162A', label: '< 5K' },\n      { gte: 5000,  lt: 10000,  color: '#FF9830', label: '5-10K' },\n      { gte: 10000, lt: 15000,  color: '#56A64B', label: '10-15K' },\n      { gte: 15000,             color: '#19730E', label: '15K+' }\n    ]\n  },\n  calendar: {\n    top: 30,\n    left: 45,\n    right: 20,\n    cellSize: ['auto', 15],\n    range: range,\n    itemStyle: { color: empty, borderColor: gap, borderWidth: 2 },\n    splitLine: { show: false },\n    yearLabel: { show: false },\n    dayLabel: { firstDay: 1, color: ink2, nameMap: ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'] },\n    monthLabel: { color: ink }\n  },\n  series: [{\n    type: 'heatmap',\n    coordinateSystem: 'calendar',\n    data: points,\n    itemStyle: { borderRadius: 2, borderColor: gap, borderWidth: 2 }\n  }]\n};",
        "renderer": "canvas",
        "theme": "default",
        "editor": {
          "format": "auto",
          "height": 600
        }
      }
    }
  ]
}
